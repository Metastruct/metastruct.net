METACONCORD_URL=https://metaconcord.metastruct.net

# Dev only. Metaconcord's session cookie is scoped to .metastruct.net and Secure, so
# localhost cannot hold one. Paste the value here and the dev proxy sends it upstream.
# Log in on https://metastruct.net, then devtools > Application > Cookies > ghSession.
# It is a live session against production metaconcord and expires after 8 hours.
MC_SESSION=
